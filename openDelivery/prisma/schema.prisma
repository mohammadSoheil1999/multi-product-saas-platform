generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  BUSINESS
  COURIER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
  DELETION_REQUESTED
}

enum VehicleType {
  CAR
  MOTORCYCLE
  SCOOTER
  BICYCLE
  WALKING
  OTHER
}

enum Availability {
  AVAILABLE
  OFFLINE
}

enum PricingMode {
  FIXED
  OFFER
}

enum Payer {
  BUSINESS
  CUSTOMER
}

enum CashStatus {
  NOT_DUE
  EXPECTED
  RECEIVED
  DISPUTED
}

enum DeliveryStatus {
  AVAILABLE
  COURIER_SELECTED
  COURIER_TO_PICKUP
  AT_PICKUP
  PICKED_UP
  IN_TRANSIT
  AT_DESTINATION
  DELIVERED
  COMPLETED
  CANCELLED_BY_BUSINESS
  CANCELLED_BY_COURIER
  DISPUTED
}

enum OfferStatus {
  ACTIVE
  SELECTED
  WITHDRAWN
  REJECTED
}

enum PackageCategory {
  FOOD
  GROCERIES
  PHARMACY
  FLOWERS
  DOCUMENTS
  PACKAGE
  ELECTRONICS
  CLOTHING
  AUTO_PARTS
  CAKE
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum SubscriptionStatus {
  NONE
  TRIAL
  ACTIVE
  SUSPENDED
}

model Tenant {
  id                        String           @id @default(cuid())
  name                      String
  slug                      String           @unique
  logoUrl                   String?
  domain                    String?          @unique
  currency                  String           @default("ILS")
  country                   String           @default("IL")
  timezone                  String           @default("Asia/Jerusalem")
  defaultLanguage           String           @default("en")
  enabledLanguages          String[]         @default(["en", "ar", "he"])
  supportEmail              String?
  supportPhone              String?
  termsVersion              String           @default("draft-1")
  privacyVersion            String           @default("draft-1")
  customerDataRetentionDays Int              @default(90)
  status                    TenantStatus     @default(ACTIVE)
  users                     User[]
  businesses                Business[]
  couriers                  CourierProfile[]
  deliveries                Delivery[]
  serviceAreas              ServiceArea[]
  categories                Category[]
  reports                   Report[]
  notifications             Notification[]
  auditLogs                 AuditLog[]
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
}

model User {
  id                String                  @id @default(cuid())
  tenantId          String
  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  email             String
  emailVerified     Boolean                 @default(false)
  passwordHash      String?
  name              String
  phone             String
  image             String?
  role              Role
  status            UserStatus              @default(PENDING)
  preferredLanguage String                  @default("en")
  sessionVersion    Int                     @default(0)
  failedLoginCount  Int                     @default(0)
  lockedUntil       DateTime?
  deletedAt         DateTime?
  business          Business?
  courierProfile    CourierProfile?
  accounts          Account[]
  sessions          Session[]
  termsAcceptances  TermsAcceptance[]
  sentMessages      Message[]
  notifications     Notification[]
  ratingsGiven      Rating[]                @relation("Reviewer")
  ratingsReceived   Rating[]                @relation("Reviewee")
  reportsMade       Report[]                @relation("Reporter")
  statusHistory     DeliveryStatusHistory[]
  auditLogs         AuditLog[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([tenantId, email])
  @@unique([email])
  @@index([tenantId, role])
  @@index([tenantId, status])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Business {
  id                        String             @id @default(cuid())
  tenantId                  String
  tenant                    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId                    String             @unique
  user                      User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  name                      String
  category                  String
  address                   String
  latitude                  Decimal            @db.Decimal(9, 6)
  longitude                 Decimal            @db.Decimal(9, 6)
  city                      String
  openingHours              Json
  logoUrl                   String?
  registrationNumber        String?
  defaultPickupInstructions String?
  defaultDeliveryPriceMinor Int?
  preferredPricingMode      PricingMode        @default(FIXED)
  defaultCashPayer          Payer              @default(BUSINESS)
  subscriptionPlan          String?
  subscriptionStatus        SubscriptionStatus @default(NONE)
  suspendedAt               DateTime?
  deliveries                Delivery[]
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@index([tenantId])
}

model CourierProfile {
  id           String               @id @default(cuid())
  tenantId     String
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  userId       String               @unique
  user         User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  city         String
  vehicleType  VehicleType
  availability Availability         @default(OFFLINE)
  latitude     Decimal?             @db.Decimal(9, 6)
  longitude    Decimal?             @db.Decimal(9, 6)
  suspendedAt  DateTime?
  serviceAreas CourierServiceArea[]
  deliveries   Delivery[]
  offers       DeliveryOffer[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([tenantId, availability])
}

model ServiceArea {
  id         String               @id @default(cuid())
  tenantId   String
  tenant     Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name       String
  city       String
  radiusKm   Int                  @default(20)
  centerLat  Decimal?             @db.Decimal(9, 6)
  centerLng  Decimal?             @db.Decimal(9, 6)
  active     Boolean              @default(true)
  couriers   CourierServiceArea[]
  deliveries Delivery[]
  createdAt  DateTime             @default(now())

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

model CourierServiceArea {
  courierId     String
  serviceAreaId String
  courier       CourierProfile @relation(fields: [courierId], references: [id], onDelete: Cascade)
  serviceArea   ServiceArea    @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)

  @@id([courierId, serviceAreaId])
}

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([tenantId, name])
}

model Delivery {
  id                       String                  @id @default(cuid())
  tenantId                 String
  tenant                   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  number                   String
  businessId               String
  business                 Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  courierId                String?
  courier                  CourierProfile?         @relation(fields: [courierId], references: [id], onDelete: Restrict)
  serviceAreaId            String
  serviceArea              ServiceArea             @relation(fields: [serviceAreaId], references: [id], onDelete: Restrict)
  status                   DeliveryStatus          @default(AVAILABLE)
  pricingMode              PricingMode
  offeredPriceMinor        Int
  agreedPriceMinor         Int?
  currency                 String                  @default("ILS")
  payer                    Payer
  cashStatus               CashStatus              @default(EXPECTED)
  pickupName               String
  pickupContactName        String
  pickupPhone              String
  pickupAddress            String
  pickupLatitude           Decimal                 @db.Decimal(9, 6)
  pickupLongitude          Decimal                 @db.Decimal(9, 6)
  pickupInstructions       String?
  readyAt                  DateTime
  customerName             String
  customerPhone            String
  destinationAddress       String
  destinationLatitude      Decimal                 @db.Decimal(9, 6)
  destinationLongitude     Decimal                 @db.Decimal(9, 6)
  destinationArea          String
  deliveryInstructions     String?
  packageCategory          PackageCategory
  packageDescription       String
  approximateSize          String?
  handlingNotes            String?
  fragile                  Boolean                 @default(false)
  keepUpright              Boolean                 @default(false)
  temperatureSensitive     Boolean                 @default(false)
  estimatedDistanceMeters  Int?
  estimatedDurationSeconds Int?
  cancellationReason       String?
  parentDeliveryId         String?
  parentDelivery           Delivery?               @relation("Reposts", fields: [parentDeliveryId], references: [id], onDelete: SetNull)
  reposts                  Delivery[]              @relation("Reposts")
  offers                   DeliveryOffer[]
  history                  DeliveryStatusHistory[]
  conversation             Conversation?
  ratings                  Rating[]
  reports                  Report[]
  anonymizedAt             DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  completedAt              DateTime?

  @@unique([tenantId, number])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, businessId, createdAt])
  @@index([tenantId, courierId, createdAt])
  @@index([tenantId, serviceAreaId, status])
}

model DeliveryOffer {
  id          String         @id @default(cuid())
  deliveryId  String
  courierId   String
  amountMinor Int
  status      OfferStatus    @default(ACTIVE)
  delivery    Delivery       @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  courier     CourierProfile @relation(fields: [courierId], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([deliveryId, courierId])
  @@index([deliveryId, status])
}

model DeliveryStatusHistory {
  id             String          @id @default(cuid())
  deliveryId     String
  actorUserId    String?
  previousStatus DeliveryStatus?
  newStatus      DeliveryStatus
  metadata       Json?
  delivery       Delivery        @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  actor          User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())

  @@index([deliveryId, createdAt])
}

model Conversation {
  id         String    @id @default(cuid())
  deliveryId String    @unique
  delivery   Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  messages   Message[]
  createdAt  DateTime  @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderUserId   String
  body           String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  type      String
  titleKey  String
  bodyKey   String
  data      Json?
  readAt    DateTime?
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([tenantId, createdAt])
}

model Rating {
  id          String    @id @default(cuid())
  deliveryId  String
  reviewerId  String
  revieweeId  String
  stars       Int
  comment     String?
  moderatedAt DateTime?
  delivery    Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Restrict)
  reviewer    User      @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewee    User      @relation("Reviewee", fields: [revieweeId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())

  @@unique([deliveryId, reviewerId])
  @@index([revieweeId, createdAt])
}

model Report {
  id         String         @id @default(cuid())
  tenantId   String
  deliveryId String?
  reporterId String
  category   String
  details    String
  status     ReportStatus   @default(OPEN)
  adminNotes String?
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  delivery   Delivery?      @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  reporter   User           @relation("Reporter", fields: [reporterId], references: [id], onDelete: Restrict)
  actions    ReportAction[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([tenantId, status, createdAt])
}

model ReportAction {
  id          String   @id @default(cuid())
  reportId    String
  adminUserId String
  action      String
  notes       String?
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([reportId, createdAt])
}

model TermsAcceptance {
  id           String   @id @default(cuid())
  userId       String
  documentType String
  version      String
  acceptedAt   DateTime @default(now())
  ipHash       String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, documentType, version])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  adminUserId String
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  ipHash      String?
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  admin       User     @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([targetType, targetId])
}

model SecurityEvent {
  id        String   @id @default(cuid())
  tenantId  String?
  emailHash String?
  userId    String?
  type      String
  requestId String
  ipHash    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([tenantId, type, createdAt])
  @@index([emailHash, createdAt])
}
